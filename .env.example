# Copy to .env and fill in. `npx wrangler deploy --secrets-file .env` uploads
# these as encrypted Worker secrets; `npx wrangler dev` reads them locally.

# Random string; part of the webhook URL. Generate with: openssl rand -hex 32
WEBHOOK_PATH_SECRET=

S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Optional. Prepended to every object key, for example "embeddings/".
# S3_KEY_PREFIX=

# Optional. Only for S3-compatible storage, for example
# https://<account-id>.r2.cloudflarestorage.com (with S3_REGION=auto) or http://localhost:9000.
# S3_ENDPOINT=

# Set after you create the webhook on inference.net (deploy step 4).
# INFERENCE_WEBHOOK_ID=
